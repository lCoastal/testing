    return string.format("phase=%s pan=%s fill=%s capacity=%s pos=%s distDig=%s distWater=%s dredge=%s running=%s zone=%s waiting=%s completed=%s rewards=%s cycles=%s digIdleSec=%s collectPendingSec=%s lastCollectMs=%s lastCollectResult=%s",
        tostring(S.diagPhase or "Idle"),tostring(pan and pan.tool.Name or "NOT EQUIPPED"),
        tostring(f),tostring(cap),pos,distance(S.dig),distance(S.water),
        tostring(S.dredge),tostring(S.running),
        tostring(S.dredgeAt or S.activeZone),tostring(S.waiting),
        tostring(S.completed),tostring(S.rewards),tostring(S.cycles),
        digIdle,collectPending,tostring(S.diagLastCollectMs or "N/A"),
        tostring(S.diagLastCollectResult or "N/A"))
end
-- Live Debug uses periodic snapshots independent of the action trace.
-- Writes are buffered, bounded without appendfile, and never block a pan call.
S.liveDebugEnabled=true
S.liveDebugFile="GalaxisHub_LiveDebug_"..os.date("%Y%m%d_%H%M%S")..".txt"
local liveSuffix=1
while fileExists(S.liveDebugFile) do
    liveSuffix+=1
    S.liveDebugFile="GalaxisHub_LiveDebug_"..os.date("%Y%m%d_%H%M%S").."_"..liveSuffix..".txt"
end
S.liveDebugHeader="GALAXIS HUB BETA | LIVE DEBUG | "..os.date("%Y-%m-%d %H:%M:%S")..
    "\nSnapshot interval: 2s while farming, 8s while idle; buffered file writes\n"
S.liveDebugQueue={}
S.liveDebugRolling={}
S.liveDebugRecent={}
S.liveDebugError=nil
S.liveDebugReady=false
S.liveDebugWriting=false
S.liveDebugFallback=false
S.liveDebugLastState=nil
S.liveDebugLastChangeAt=os.clock()
S.liveDebugLastStallAt=0
if type(writefile)=="function" then
    local ok,err=pcall(writefile,S.liveDebugFile,S.liveDebugHeader)
    S.liveDebugReady=ok
    if not ok then S.liveDebugError=tostring(err) end
else
    S.liveDebugError="writefile unavailable"
end
function S.liveDebugRecord(kind,detail)
    if not S.liveDebugEnabled then return end
    local flat=tostring(detail or ""):gsub("[\r\n]"," / ")
    local line=os.date("%Y-%m-%d %H:%M:%S").." | "..tostring(kind).." | "..flat.."\n"
    local queue=S.liveDebugQueue
    queue[#queue+1]=line
    if #queue>400 then table.remove(queue,1) end
    local recent=S.liveDebugRecent
    recent[#recent+1]=line
    if #recent>40 then table.remove(recent,1) end
end
function S.flushLiveDebug()
    if S.liveDebugWriting or not S.liveDebugReady or #S.liveDebugQueue==0 then return end
    S.liveDebugWriting=true
    local batch=S.liveDebugQueue
    S.liveDebugQueue={}
    local rolling=S.liveDebugRolling
    for _,line in ipairs(batch) do
        rolling[#rolling+1]=line
        if #rolling>900 then table.remove(rolling,1) end
    end
    local ok,err=false,nil
    if type(appendfile)=="function" and not S.liveDebugFallback then
        ok,err=pcall(appendfile,S.liveDebugFile,table.concat(batch))
        if not ok then S.liveDebugFallback=true end
    end
    if not ok and type(writefile)=="function" then
        ok,err=pcall(writefile,S.liveDebugFile,S.liveDebugHeader..table.concat(rolling))
    end
    if not ok then
        S.liveDebugError=tostring(err)
        for _,line in ipairs(batch) do
            S.liveDebugQueue[#S.liveDebugQueue+1]=line
        end
        while #S.liveDebugQueue>400 do table.remove(S.liveDebugQueue,1) end
    else
        S.liveDebugError=nil
    end
    S.liveDebugWriting=false
end
function S.liveDebugDetails()
    local action=S.traceCurrentAction or "none"
    local age=S.traceActionStartedAt and (os.clock()-S.traceActionStartedAt) or 0
    return "selected="..tostring(ZONE_NAMES[S.selectedZone] or "none")..
        " | activeAction="..tostring(action)..
        " age="..string.format("%.2fs",age)..
        " | objective="..tostring(S.dredgeCurrentWork or "none")..
        " | next="..tostring(S.dredgeNextWork or "none")..
        " | cap="..tostring(S.dredgeAppliedCap or "unset")..
        " | lastError="..tostring(S.diagLastFailure or "none")..
        " | "..S.diagSnapshot()
end
S.liveDebugRecord("START","Live debug initialized")
task.spawn(function()
    local lastSample=0
    local lastFlush=0
    while S.alive do
        local now=os.clock()
        local state=tostring(S.running).."|"..tostring(S.dredge).."|"..
            tostring(S.diagPhase).."|"..tostring(S.traceCurrentAction).."|"..
            tostring(S.dredgeAt or S.activeZone).."|"..tostring(S.dredgeCurrentWork)
        if state~=S.liveDebugLastState then
            S.liveDebugLastState=state
            S.liveDebugLastChangeAt=now
            S.liveDebugRecord("STATE_CHANGE",S.liveDebugDetails())
        end
        if now-lastSample>=(S.running and 2 or 8) then
            lastSample=now
            S.liveDebugRecord("SNAPSHOT",S.liveDebugDetails())
        end
        -- Detect a silent idle state even without an ACTION_START event.
        if S.running and now-S.liveDebugLastChangeAt>=6
            and now-S.liveDebugLastStallAt>=6 then
            S.liveDebugLastStallAt=now
            S.liveDebugRecord("POSSIBLE_STALL",
                "State unchanged for "..string.format("%.1fs",now-S.liveDebugLastChangeAt)..
                " | "..S.liveDebugDetails())
        end
        if now-lastFlush>=1.5 then
            lastFlush=now
            S.flushLiveDebug()
        end
        task.wait(.5)
    end
    S.flushLiveDebug()
end)

function S.diagReport()
    local lines={
        "GALAXIS HUB DEBUG REPORT",
        "Generated: "..os.date("%Y-%m-%d %H:%M:%S"),
        "Only local pan/position/cycle data; no remote packets or credentials.",
        "CURRENT: "..S.diagSnapshot(),
        "Last failure: "..tostring(S.diagLastFailure or "None"),
        "ACTION TRACE FILE: "..tostring(S.actionTraceFile),
        "LIVE DEBUG FILE: "..tostring(S.liveDebugFile),
        "Live debug error: "..tostring(S.liveDebugError or "None"),
        "Action trace enabled: "..tostring(S.actionTraceEnabled),
        "Action trace file error: "..tostring(S.actionTraceError or "None"),
        "Anti-AFK: "..tostring(S.antiAfk),
        "Anti-AFK last activation: "..tostring(S.antiAfkLastAt or "None"),
        "Dig calls this pan: "..tostring(S.diagDigCalls or 0),
        "Dig stall count: "..tostring(S.diagDigStalls or 0),
        "Current task: "..tostring(S.dredgeCurrentWork),
        "Next task: "..tostring(S.dredgeNextWork),
        "Quest status: "..tostring(S.dredgeServerStatus and S.dredgeServerStatus.status),
        "Quest step: "..tostring(S.dredgeServerStatus and S.dredgeServerStatus.step),
        "Quest poll busy: "..tostring(S.dredgePollBusy),
        "Quest poll error: "..tostring(S.dredgeQuestPollError),
        "Quest poll attempts: "..tostring(S.dredgePollAttempts or 0),
        "Quest poll started: "..tostring(S.dredgePollStartedAt),
        "Quest poll ended: "..tostring(S.dredgePollCompletedAt),
        "Dredge initialization age (s): "..tostring(
            S.dredgeInitAt and math.floor(os.clock()-S.dredgeInitAt) or "N/A"),
        "RECENT EVENTS:"
    }
    for _,line in ipairs(S.DIAG_LOG) do lines[#lines+1]=line end
    lines[#lines+1]="--- ACTION TRACE TAIL ---"
    for i=math.max(1,#S.actionTraceTail-79),#S.actionTraceTail do
        lines[#lines+1]=S.actionTraceTail[i]
    end
    return table.concat(lines,"\n").."\n"
end
local function pause(sec,id,ready)
    local deadline=os.clock()+sec
    while os.clock()<deadline do
        if not valid(id) then return false end
        if ready and ready() then return true end
        task.wait(.01)
    end
    return valid(id)
end
-- One in-flight request per RemoteFunction. If a request times out locally,
-- the server may still complete it. Preserve that result for the retry
-- instead of accidentally sending a second Collect/Pan concurrently.
local function invoke(r,id,...)
    if not valid(id) then return false,nil,"Worker stopped" end
    -- A 3s hard timeout killed otherwise healthy Dredge sessions when
    -- Pan's InvokeServer reply was simply slow. Wait for the same request,
    -- never send an overlapping duplicate.
    local timeout=(r.Name=="Pan" and CFG.panTimeout)
        or (r.Name=="Collect" and CFG.collectTimeout) or CFG.timeout
    S.rpcInFlight=S.rpcInFlight or setmetatable({},{__mode="k"})
    local call=S.rpcInFlight[r]
    if call then
        -- A previous session may have stopped while this server request
        -- was still in flight. Never discard it and send a duplicate.
        if call.token~=id then
            if not call.done then
                S.diagEvent("RPC_PREVIOUS_SESSION_WAIT",
                    r.Name.." still pending from earlier session; no duplicate request")
                local nextLog=os.clock()+12
                while valid(id) and not call.done do
                    task.wait(.1)
                    if os.clock()>=nextLog then
                        S.diagEvent("RPC_RECOVERY_WAIT",string.format(
                            "%s previous request pending %.1fs",
                            r.Name,os.clock()-call.started))
                        nextLog=os.clock()+12
                    end
                end
            end
            if not valid(id) then return false,nil,"Worker stopped" end
            S.rpcInFlight[r]=nil
            S.diagEvent("RPC_PREVIOUS_SESSION_SETTLED",r.Name..
                " | previous result discarded; recheck live Fill")
            -- This invocation has different arguments/session. Its caller
            -- must recheck actual pan state rather than reuse an old reply.
            return false,nil,"Prior "..r.Name.." request settled; retry after state check"
        end
        if not call.done then
            S.diagEvent("RPC_RECOVERY_WAIT",r.Name.." still in flight; waiting")
            local nextLog=os.clock()+12
            while valid(id) and not call.done do
                task.wait(.1)
                if os.clock()>=nextLog then
                    S.diagEvent("RPC_RECOVERY_WAIT",string.format(
                        "%s pending %.1fs",r.Name,os.clock()-call.started))
                    nextLog=os.clock()+12
                end
            end
        end
        if not valid(id) then return false,nil,"Worker stopped" end
        S.rpcInFlight[r]=nil
        if not call.ok then
            return false,nil,"Delayed "..r.Name.." error: "..tostring(call.response)
        end
        S.diagEvent("RPC_LATE_RESPONSE",r.Name.." completed ("..
            string.format("%.2fs",os.clock()-call.started)..")")
        return true,call.response,nil
    end
    local args=table.pack(...)
    call={token=id,started=os.clock(),done=false,ok=false,response=nil}
    S.rpcInFlight[r]=call
    task.spawn(function()
        if valid(id) then
            call.ok,call.response=pcall(function()
                return r:InvokeServer(table.unpack(args,1,args.n))
            end)
        else
            call.ok=false
            call.response="Worker stopped before call"
        end
        call.done=true
    end)
    local deadline=os.clock()+timeout
    local reportedSlow=false
    while valid(id) and not call.done and os.clock()<deadline do
        if not reportedSlow and os.clock()-call.started>=CFG.timeout then
            reportedSlow=true
            S.diagEvent("RPC_SLOW_WAIT",r.Name..
                " exceeded 3s; waiting for original server reply, no duplicate sent")
        end
        task.wait(.02)
    end
    if not valid(id) then return false,nil,"Worker stopped" end
    if not call.done then
        local detail=string.format("%s exceeded %.1fs (still in flight)",
            r.Name,timeout)
        S.diagEvent("RPC_TIMEOUT",detail)
        if r.Name=="Collect" or r.Name=="Pan" then
            -- Recovery is deliberately off the normal fast path. Keep the
            -- SAME InvokeServer alive until it actually returns; never
            -- overlap another Collect/Pan with an unresolved one.
            S.diagEvent("RPC_RECOVERY_WAIT",r.Name..
                " | holding original request; stop toggle remains responsive")
            local nextLog=os.clock()+12
            while valid(id) and not call.done do
                task.wait(.1)
                if os.clock()>=nextLog then
                    S.diagEvent("RPC_RECOVERY_WAIT",string.format(
                        "%s still waiting %.1fs | no duplicate sent",
                        r.Name,os.clock()-call.started))
                    nextLog=os.clock()+12
                end
            end
            if not valid(id) then return false,nil,"Worker stopped" end
            S.diagEvent("RPC_RECOVERY_DONE",r.Name..
                " | reply received after "..
                string.format("%.2fs",os.clock()-call.started))
        else
            -- Quest/status calls retain their original short timeout.
            -- A later invocation will first wait for this one to settle.
            return false,nil,detail
        end
    end
    S.rpcInFlight[r]=nil
    if not call.ok then
        local detail="InvokeServer error: "..tostring(call.response)
        S.diagEvent("RPC_ERROR",r.Name.." | "..detail:sub(1,200))
        return false,nil,detail
    end
    return true,call.response,nil
end
-- Equip the pan only when necessary. No waits/checks on the normal
-- hot path: an equipped pan is recognized by its Character parent.
local function requirePanEquipped(r,id)
    if not valid(id) then return false end
    local character=P.Character
    if character and r.tool.Parent==character then return true end
    local hum=character and character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 or not r.tool:IsDescendantOf(game) then
        return false
    end
    local bag=P:FindFirstChildOfClass("Backpack")
    if not bag or r.tool.Parent~=bag then return false end
    S.diagEvent("PAN_AUTO_EQUIP",r.tool.Name)
    local ok=pcall(function() hum:EquipTool(r.tool) end)
    if not ok then return false end
    local untilAt=os.clock()+.4
    while valid(id) and os.clock()<untilAt do
        if r.tool.Parent==character then return true end
        task.wait(.02)
    end
    return valid(id) and r.tool.Parent==character
end
local function move(cf,id)
    if typeof(cf)~="CFrame" then
        S.diagEvent("MOVE_MISSING_POSITION",
            "Invalid destination; zone="..tostring(S.dredgeAt or S.activeZone))
        return false
    end
    for _=1,2 do
        if not valid(id) then return false end
        local r=root()
        if not r then return false end
        if (r.Position-cf.Position).Magnitude<7 then return true end
        local ok=pcall(function() r.CFrame=cf end)
        if not ok or not pause(S.timing("teleport"),id) then return false end
        r=root()
        if r and (r.Position-cf.Position).Magnitude<10 then return true end
    end
    return false
end

