    local ok,saved=pcall(readfile,ACTIVE_LOG_POINTER)
    if ok and type(saved)=="string" then
        saved=saved:match("^%s*(.-)%s*$")
        if saved:match("^[%w_%-%.]+%.txt$") and #saved<=120 then FILE=saved end
    end
end
