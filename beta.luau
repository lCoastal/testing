function S.packCF(cf)
    if typeof(cf)~="CFrame" then return nil end
    return {cf:GetComponents()}
end
function S.unpackCF(t)
    if type(t)~="table" or #t~=12 then return nil end
    for i=1,12 do
        if type(t[i])~="number" or t[i]~=t[i] or math.abs(t[i])>1e12 then return nil end
    end
    local ok,cf=pcall(function() return CFrame.new(table.unpack(t)) end)
    return ok and cf or nil
end
function S.decodePresetFile(name)
    if type(readfile)~="function" then return nil end
    if type(isfile)=="function" then
        local ok,exists=pcall(isfile,name)
        if ok and not exists then return nil end
    end
    local ok,raw=pcall(readfile,name)
    if not ok then return nil end
    local decoded,data=pcall(function() return HttpService:JSONDecode(raw) end)
    return decoded and type(data)=="table" and data or nil
end
function S.savePresets()
    if type(writefile)~="function" then return false,"writefile unavailable" end
    local ok,json=pcall(function()
        return HttpService:JSONEncode({
            version=2,
            selectedZone=ZONE_NAMES[S.selectedZone],
            selectedWaypoint=WAYPOINT_NAMES[S.selectedWaypoint],
            zones=S.overrides
        })
    end)
    if not ok then return false,tostring(json) end
    local written,err=pcall(writefile,PRESET_FILE,json)
    return written,written and nil or tostring(err)
end
function S.validPreset(p)
    if type(p)~="table" then return nil end
    local dig,water=S.unpackCF(p.dig),S.unpackCF(p.water)
    local waypoint=type(p.waypoint)=="string" and waypointIndex[p.waypoint] and p.waypoint or nil
    -- Optional sparse points, ordered from the mapped stone to the dig
    -- location. The same points are used backward when returning.
    local function parseNodes(value)
        if type(value)~="table" then return nil end
        local nodes={}
        for _,node in ipairs(value) do
            local cf=S.unpackCF(node)
            if cf and #nodes<500 then nodes[#nodes+1]=S.packCF(cf) end
        end
        return nodes
    end
    local route=parseNodes(p.route)
    local routeOut=parseNodes(p.routeOut)
    local function parseJumps(value,count)
        local jumps={}
        if type(value)=="table" then
            for _,index in ipairs(value) do
                if type(index)=="number" and index>=1 and index<=count
                    and index%1==0 then
                    jumps[#jumps+1]=index
                end
            end
        end
        return jumps
    end
    local routeJumps=parseJumps(p.routeJumps,route and #route or 0)
    local routeOutJumps=parseJumps(p.routeOutJumps,routeOut and #routeOut or 0)
    if dig or water or waypoint or route or routeOut then
        return {dig=S.packCF(dig),water=S.packCF(water),
            waypoint=waypoint,route=route,routeOut=routeOut,
            routeJumps=routeJumps,routeOutJumps=routeOutJumps}
    end
    return nil
end
