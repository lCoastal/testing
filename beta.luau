function S.waypointFolder()
    local map=workspace:FindFirstChild("Map")
    return map and map:FindFirstChild("Waypoints")
end
function S.getWaypointCF(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then
        obj=obj:FindFirstChildWhichIsA("BasePart",true)
    end
    if not obj then return nil end
    local ok,cf=pcall(function() return obj:GetPivot() end)
    return ok and cf or nil
end
function S.closestWaypoint(folder,pos)
    local best,dist=nil,math.huge
    for _,node in ipairs(folder:GetChildren()) do
        local cf=S.getWaypointCF(node)
        if cf then
            local d=(cf.Position-pos).Magnitude
            if d<dist then best=node;dist=d end
        end
    end
    return best
end

function S.timing(key)
    return (S.turbo and TURBO[key]) or CFG[key]
end

local function valid(id) return S.alive and S.running and S.token==id end
local function bind(sig,fn) local c=sig:Connect(fn);S.links[#S.links+1]=c;return c end
local function root() local c=P.Character;return c and c:FindFirstChild("HumanoidRootPart") end
local function panTool()
    local c=P.Character
    if not c then return end
    for _,t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local x=t:FindFirstChild("Scripts")
            local d=x and x:FindFirstChild("Collect")
            local p=x and x:FindFirstChild("Pan")
            local s=x and x:FindFirstChild("Shake")
            if d and p and s and d:IsA("RemoteFunction") and p:IsA("RemoteFunction") and s:IsA("RemoteEvent") then
                return {tool=t,dig=d,pan=p,shake=s,done=x:FindFirstChild("PanningComplete")}
            end
        end
    end
end
-- Find a compatible pan whether held or temporarily in Backpack.
function S.panInBackpack()
    local bag=P:FindFirstChildOfClass("Backpack")
    local custom=P:FindFirstChild("BackpackTwo")
    for _,container in ipairs({bag or false,custom or false}) do
        if container then
            for _,tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") then
                    local scripts=tool:FindFirstChild("Scripts")
                    local d=scripts and scripts:FindFirstChild("Collect")
                    local p=scripts and scripts:FindFirstChild("Pan")
                    local sh=scripts and scripts:FindFirstChild("Shake")
                    if d and p and sh and d:IsA("RemoteFunction") and
                        p:IsA("RemoteFunction") and sh:IsA("RemoteEvent") then
                        return {tool=tool,dig=d,pan=p,shake=sh,
                            done=scripts:FindFirstChild("PanningComplete")}
                    end
                end
            end
        end
    end
end
