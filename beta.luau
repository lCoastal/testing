local function waypointFolder()
    local map=workspace:FindFirstChild("Map")
    return map and map:FindFirstChild("Waypoints")
end
local function getWaypointCF(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then
        obj=obj:FindFirstChildWhichIsA("BasePart",true)
    end
    if not obj then return nil end
    local ok,cf=pcall(function() return obj:GetPivot() end)
    return ok and cf or nil
end
local function closestWaypoint(folder,pos)
    local best,dist=nil,math.huge
    for _,node in ipairs(folder:GetChildren()) do
        local cf=getWaypointCF(node)
        if cf then
            local d=(cf.Position-pos).Magnitude
            if d<dist then best=node;dist=d end
        end
    end
    return best
end

local function timing(key)
    return (S.turbo and TURBO[key]) or CFG[key]
end

local function valid(id) return S.alive and S.running and S.token==id end
local function bind(sig,fn) local c=sig:Connect(fn);S.links[#S.links+1]=c;return c end
local function root() local c=P.Character;return c and c:FindFirstChild("HumanoidRootPart") end
local function panTool()
    local c=P.Character
    if not c then return end
    for _,t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local x=t:FindFirstChild("Scripts")
            local d=x and x:FindFirstChild("Collect")
            local p=x and x:FindFirstChild("Pan")
            local s=x and x:FindFirstChild("Shake")
            if d and p and s and d:IsA("RemoteFunction") and p:IsA("RemoteFunction") and s:IsA("RemoteEvent") then
                return {tool=t,dig=d,pan=p,shake=s,done=x:FindFirstChild("PanningComplete")}
            end
        end
    end
end
local function fill(r) return tonumber(r.tool:GetAttribute("Fill")) end
local function capacity()
    local a=P:FindFirstChild("Stats")
    return a and tonumber(a:GetAttribute("Capacity"))
end
function S.diagSnapshot()
    local r=root()
    local pan=panTool()
    local f=pan and fill(pan)
    local cap=capacity()
    local function distance(cf)
        return (r and cf) and string.format("%.1f",(r.Position-cf.Position).Magnitude) or "N/A"
    end
    local pos=r and string.format("%.1f,%.1f,%.1f",
        r.Position.X,r.Position.Y,r.Position.Z) or "N/A"
    local digIdle=S.diagDigProgressAt and
        string.format("%.2f",os.clock()-S.diagDigProgressAt) or "N/A"
    local collectPending=S.diagCollectPendingAt and
        string.format("%.2f",os.clock()-S.diagCollectPendingAt) or "no"
    return string.format("phase=%s pan=%s fill=%s capacity=%s pos=%s distDig=%s distWater=%s dredge=%s running=%s zone=%s waiting=%s completed=%s rewards=%s cycles=%s digIdleSec=%s collectPendingSec=%s lastCollectMs=%s lastCollectResult=%s",
        tostring(S.diagPhase or "Idle"),tostring(pan and pan.tool.Name or "NOT EQUIPPED"),
        tostring(f),tostring(cap),pos,distance(S.dig),distance(S.water),
        tostring(S.dredge),tostring(S.running),
        tostring(S.dredgeAt or S.activeZone),tostring(S.waiting),
        tostring(S.completed),tostring(S.rewards),tostring(S.cycles),
        digIdle,collectPending,tostring(S.diagLastCollectMs or "N/A"),
        tostring(S.diagLastCollectResult or "N/A"))
end
function S.diagReport()
    local lines={
        "GALAXIS HUB DEBUG REPORT",
        "Generated: "..os.date("%Y-%m-%d %H:%M:%S"),
        "Only local pan/position/cycle data; no remote packets or credentials.",
        "CURRENT: "..S.diagSnapshot(),
        "Last failure: "..tostring(S.diagLastFailure or "None"),
        "ACTION TRACE FILE: "..tostring(S.actionTraceFile),
        "Action trace enabled: "..tostring(S.actionTraceEnabled),
        "Action trace file error: "..tostring(S.actionTraceError or "None"),
        "Anti-AFK: "..tostring(S.antiAfk),
        "Anti-AFK last activation: "..tostring(S.antiAfkLastAt or "None"),
        "Dig calls this pan: "..tostring(S.diagDigCalls or 0),
        "Dig stall count: "..tostring(S.diagDigStalls or 0),
        "Current task: "..tostring(S.dredgeCurrentWork),
        "Next task: "..tostring(S.dredgeNextWork),
        "Quest status: "..tostring(S.dredgeServerStatus and S.dredgeServerStatus.status),
        "Quest step: "..tostring(S.dredgeServerStatus and S.dredgeServerStatus.step),
        "Quest poll busy: "..tostring(S.dredgePollBusy),
        "Quest poll error: "..tostring(S.dredgeQuestPollError),
        "Quest poll attempts: "..tostring(S.dredgePollAttempts or 0),
        "Quest poll started: "..tostring(S.dredgePollStartedAt),
        "Quest poll ended: "..tostring(S.dredgePollCompletedAt),
        "Dredge initialization age (s): "..tostring(
            S.dredgeInitAt and math.floor(os.clock()-S.dredgeInitAt) or "N/A"),
        "RECENT EVENTS:"
    }
    for _,line in ipairs(S.DIAG_LOG) do lines[#lines+1]=line end
    lines[#lines+1]="--- ACTION TRACE TAIL ---"
    for i=math.max(1,#S.actionTraceTail-79),#S.actionTraceTail do
        lines[#lines+1]=S.actionTraceTail[i]
    end
    return table.concat(lines,"\n").."\n"
end
local function pause(sec,id,ready)
    local deadline=os.clock()+sec
    while os.clock()<deadline do
        if not valid(id) then return false end
        if ready and ready() then return true end
        task.wait(.01)
    end
    return valid(id)
end
-- One in-flight request per RemoteFunction. If a request times out locally,
-- the server may still complete it. Preserve that result for the retry
-- instead of accidentally sending a second Collect/Pan concurrently.
local function invoke(r,id,...)
    if not valid(id) then return false,nil,"Worker stopped" end
    S.rpcInFlight=S.rpcInFlight or setmetatable({},{__mode="k"})
    local call=S.rpcInFlight[r]
    if call then
        if call.token~=id then
            S.rpcInFlight[r]=nil -- previous stopped session
        else
            if not call.done then
                local waitUntil=os.clock()+CFG.timeout*2
                while valid(id) and not call.done and os.clock()<waitUntil do
                    task.wait(.05)
                end
            end
            if not valid(id) then return false,nil,"Worker stopped" end
            if not call.done then
                local info=string.format("%s still pending for %.1fs",
                    r.Name,os.clock()-call.started)
                S.diagEvent("RPC_STILL_PENDING",info)
                return false,nil,info
            end
            S.rpcInFlight[r]=nil
            if not call.ok then
                return false,nil,"Delayed "..r.Name.." error: "..tostring(call.response)
            end
            S.diagEvent("RPC_LATE_RESPONSE",r.Name..
                " completed after local timeout ("..
                string.format("%.2fs",os.clock()-call.started)..")")
            return true,call.response,nil
        end
    end
    local args=table.pack(...)
    call={token=id,started=os.clock(),done=false,ok=false,response=nil}
    S.rpcInFlight[r]=call
    task.spawn(function()
        if valid(id) then
            call.ok,call.response=pcall(function()
                return r:InvokeServer(table.unpack(args,1,args.n))
            end)
        else
            call.ok=false
            call.response="Worker stopped before call"
        end
        call.done=true
    end)
    local deadline=os.clock()+CFG.timeout
    while valid(id) and not call.done and os.clock()<deadline do task.wait(.01) end
    if not valid(id) then return false,nil,"Worker stopped" end
    if not call.done then
        local detail=string.format("%s timed out after %.1fs (still in flight)",
            r.Name,CFG.timeout)
        S.diagEvent("RPC_TIMEOUT",detail)
        return false,nil,detail
    end
    S.rpcInFlight[r]=nil
    if not call.ok then
        local detail="InvokeServer error: "..tostring(call.response)
        S.diagEvent("RPC_ERROR",r.Name.." | "..detail:sub(1,200))
        return false,nil,detail
    end
    return true,call.response,nil
end
local function move(cf,id)
    for _=1,2 do
        if not valid(id) then return false end
        local r=root()
        if not r then return false end
        if (r.Position-cf.Position).Magnitude<7 then return true end
        local ok=pcall(function() r.CFrame=cf end)
        if not ok or not pause(timing("teleport"),id) then return false end
        r=root()
        if r and (r.Position-cf.Position).Magnitude<10 then return true end
    end
    return false
end

